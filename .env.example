# Server Configuration
PORT=8080
API_KEY=seruwit-secret-key-change-me

# Database Configuration
# Supported drivers: sqlite, postgres
DB_DIALECT=sqlite
DB_ADDRESS=file:data/seruwit-wa.db?_foreign_keys=on

# For PostgreSQL (Production):
# DB_DIALECT=postgres
# DB_ADDRESS=postgres://postgres:password@localhost:5432/seruwit_wa?sslmode=disable

# Webhook to seruwit-crm
CRM_WEBHOOK_URL=http://localhost:8000/api/webhook/whatsapp
CRM_WEBHOOK_SECRET=seruwit-crm-secret

# Log Level: DEBUG, INFO, WARN, ERROR
LOG_LEVEL=INFO
